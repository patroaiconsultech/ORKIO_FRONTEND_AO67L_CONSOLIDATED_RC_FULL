{
  "id": "/app",
  "name": "ORKIO — Inteligência Orquestrada",
  "short_name": "ORKIO",
  "description": "Plataforma premium de inteligência orquestrada, colaboração e governança.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "/app?source=pwa",
  "scope": "/",
  "display": "standalone",
